@subsection Faces

@table @asis
@item Face: majutsu-interactive-selected-hunk
Selected hunks.
@item Face: majutsu-interactive-selected-region
Selected lines within a hunk.
@item Face: majutsu-interactive-selected-file
Whole-file changes and fully
selected stat-summary entries.
@item Face: majutsu-interactive-partially-selected-file
Partially selected
stat-summary files and directories.
@end table

